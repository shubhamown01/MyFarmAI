{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (uvicorn, loopback)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/backend",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Web: Next.js dev server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/web",
      "runtimeArgs": ["run", "dev"]
    }
  ]
}
