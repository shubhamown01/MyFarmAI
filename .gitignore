**/.cache/huggingface/

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# IDE (project config committed; developer-local overrides not)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Generated TypeScript build info (root .json)

.idea/

# Temporary
*.tmp
*.temp

# Docker
.docker/

# Testing
.coverage
htmlcov/

# Local MCP persistent memory
.local/mcp-memory/

# Local tool state / agent workspace dirs (never commit)
.setup-backups/
.playwright-mcp/
.omo/
.local/
.codegraph

# Graphify generated artifacts (large, fully rebuildable via `graphify update .`)
graphify-out/

# Phase 4 exit-gate condition 1: local secret + misnamed SQLite artifact
.pg_password
backend/file:test

# Phase 6G: release signing material must never enter git (owner keeps the
# keystore outside the repo with its own backup)
*.keystore
*.jks
*.pem

# Vendor-installed agent skills (tooling-managed, reinstallable)
.agents/skills/catalyst-*/

# Orchestrator worktree/state directory
.orchestrator/

# Tool-managed resources bundle
resources/

# OpenCode timestamped config backups (opencode.json itself stays tracked)
opencode.json.backup*

# Scratch / one-off verification artifacts at repo root
/test-*.js
/*-evidence.png
/zoho-onboarding-*.png

# npx side-effect from running zcatalyst-cli at repo root (no root JS project)
/package.json
/package-lock.json

# expo prebuild output (generated native project, regenerate via npx expo prebuild)
android/android/
