    "scrum-master": {
      "steps": 8
    },
    "ux-researcher": {
      "steps": 10
    },
    "agent-organizer": {
      "steps": 5
    },
    "context-manager": {
      "steps": 5
    },
    "error-coordinator": {
      "steps": 10
    },
    "knowledge-synthesizer": {
      "steps": 8
    },
    "multi-agent-coordinator": {
      "steps": 10
