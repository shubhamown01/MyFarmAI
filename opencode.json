{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "gh-grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp",
        "oauth": {}
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp"
      },
      "linear": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-linear"
        ],
        "environment": {
          "LINEAR_API_KEY": "{env:LINEAR_API_KEY}"
        },
        "disabled": true
      },
      "redis": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-redis"
        ],
        "environment": {
          "REDIS_URL": "{env:REDIS_URL}"
        },
        "disabled": true
      },
      "postgres": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-postgres",
          "{env:DATABASE_URL}"
        ],
        "disabled": true
      },
      "kubernetes": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-server-kubernetes"
        ],
        "disabled": true
      },
      "puppeteer": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-puppeteer"
        ],
        "disabled": true
      },
      "aws": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@aws/mcp"
        ],
        "disabled": true
      },
      "axiom": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@axiomhq/mcp-server-axiom"
        ],
        "environment": {
          "AXIOM_TOKEN": "{env:AXIOM_TOKEN}"
        },
        "disabled": true
      },
      "screen-mcp": {
        "type": "local",
        "command": [
          "/data/screen-mcp/bin/screen-mcp"
        ],
        "environment": {
          "MCP_SCREEN_GUARD": "1",
          "MCP_SCREEN_AMBIENT": "1"
        }
      }
    }
  },
  "agents": {
    "azure-infra-engineer": {
      "steps": 15
    },
    "cloud-architect": {
      "steps": 15
    },
    "database-administrator": {
      "steps": 15
    },
    "deployment-engineer": {
      "steps": 15
    },
    "incident-responder": {
      "steps": 15
    },
    "kubernetes-specialist": {
      "steps": 15
    },
    "network-engineer": {
      "steps": 12
    },
    "platform-engineer": {
      "steps": 15
    },
    "security-engineer": {
      "steps": 15
    },
    "sre-engineer": {
      "steps": 15
    },
    "code-reviewer": {
      "steps": 15
    },
    "performance-engineer": {
      "steps": 15
    },
    "security-auditor": {
      "steps": 15
    },
    "data-analyst": {
      "steps": 12
    },
    "data-scientist": {
      "steps": 15
    },
    "database-optimizer": {
      "steps": 15
    },
    "postgres-pro": {
      "steps": 15
    },
    "prompt-engineer": {
      "steps": 10
    },
    "sql-pro": {
      "steps": 15
    },
    "dependency-manager": {
      "steps": 10
    },
    "docs-writer": {
      "steps": 10
    },
    "git-workflow-manager": {
      "steps": 8
    },
    "technical-writer": {
      "steps": 10
    },
    "accessibility-tester": {
      "steps": 10
    },
    "architect-reviewer": {
      "steps": 15
    },
    "chaos-engineer": {
      "steps": 10
    },
    "compliance-auditor": {
      "steps": 15
    },
    "debugger": {
      "steps": 20
    },
    "error-detective": {
      "steps": 15
    },
    "penetration-tester": {
      "steps": 15
    },
    "llm-architect": {
      "steps": 15
    },
    "mlops-engineer": {
      "steps": 15
    },
    "dx-optimizer": {
      "steps": 10
    },
    "seo-specialist": {
      "steps": 10
    },
    "business-analyst": {
      "steps": 10
    },
    "content-marketer": {
      "steps": 10
    },
    "legal-advisor": {
      "steps": 10
    },
    "product-manager": {
