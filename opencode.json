    "trend-analyst": {
      "steps": 10
    },
    "myfarmai-orchestrator": {
      "mode": "primary",
      "steps": 20,
      "permission": {
        "task": {
          "*": "deny",
          "myfarmai-*": "allow",
          "backend-engineer": "allow",
          "frontend-engineer": "allow",
          "android-engineer": "allow",
          "ai-ml-engineer": "allow",
          "research-engineer": "allow",
          "security-engineer": "allow",
          "qa-reviewer": "allow",
          "release-coordinator": "allow",
          "explore": "allow"
        }
      }
    },
    "backend-engineer": {
      "mode": "subagent",
      "steps": 15
    },
    "frontend-engineer": {
      "mode": "subagent",
      "steps": 15
    },
    "android-engineer": {
      "mode": "subagent",
      "steps": 15
    },
    "ai-ml-engineer": {
      "mode": "subagent",
      "steps": 15
    },
    "research-engineer": {
      "mode": "subagent",
      "steps": 15
    },
    "qa-reviewer": {
      "mode": "subagent",
      "steps": 15
    },
    "release-coordinator": {
      "mode": "subagent",
      "steps": 10
    }
  },
  "default_agent": "myfarmai-orchestrator",
  "subagent_depth": 2,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "plugin": [
    "compound-engineering@git+https://github.com/EveryInc/compound-engineering-plugin.git",
    "@opencode-ai/browser-control"
  ],
  "model": "ollama/qwen2.5-coder:3b",
  "small_model": "ollama/qwen3:0.6b"
}
