# MyFarm AI — Environment Configuration Template
# Copy to .env and fill in values. Never commit .env to version control.

# =============================================================================
# BACKEND SETTINGS
# =============================================================================
APP_NAME="My Farm AI Backend"
# APP_VERSION is derived from the installed package (pyproject); override only if needed
# APP_VERSION="1.0.0"
ENVIRONMENT="development"

# =============================================================================
# OLLAMA / LLM SETTINGS
# =============================================================================
# Base URL for Ollama API.
# - On host machine: http://localhost:11434
# - Inside Docker container (Docker Desktop): http://host.docker.internal:11434
# - Inside Docker container (Linux): http://172.17.0.1:11434 (docker0 bridge IP)
#   or use host network mode: network_mode: "host" in docker-compose.yml
OLLAMA_BASE_URL="http://host.docker.internal:11434"

# Model name to use for chat completions.
# Must match a model pulled in Ollama (run: ollama pull qwen3:4b)
OLLAMA_MODEL="qwen3:4b"

# Request timeout in seconds. Increase for slower models/hardware.
OLLAMA_TIMEOUT_SECONDS=120

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
# SQLite database file path (relative to backend working directory /app)
# In Docker, this maps to ./data/app.db on host via volume mount.
DATABASE_PATH="data/app.db"

# =============================================================================
# CORS SETTINGS (for future web/mobile clients)
# =============================================================================
# Comma-separated list of allowed origins.
# Use "*" for development only. Specify exact origins for production.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8081,exp://192.168.1.0/24"

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"

# =============================================================================
# VOICE SERVICE SETTINGS (for reference, voice service has its own config)
# =============================================================================
# Voice service URL (used by backend to proxy requests)
VOICE_SERVICE_URL="http://voice:8001"