  "components": {
    "schemas": {
      "AgriculturalResource": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Resource title"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "description": "Resource category"
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Resource URL"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Source organization"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Short factual description"
          }
        },
        "type": "object",
        "required": [
          "title",
          "category",
          "url",
          "source",
          "description"
        ],
        "title": "AgriculturalResource"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "description": "The farmer's message or question"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id",
            "description": "Existing conversation ID to continue, or null to start new"
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}$",
            "title": "Language",
            "description": "Language code (e.g., 'en', 'hi')",
            "default": "en"
          },
          "crop": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Crop",
            "description": "Farmer's current crop for context"
          },
          "location": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Location",
            "description": "Farmer's location for localized advice"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "response": {
            "type": "string",
            "title": "Response",
            "description": "Assistant's response"
          },
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id",
            "description": "Conversation ID (new or continued)"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Model used for generation"
          }
        },
        "type": "object",
        "required": [
          "response",
          "conversation_id",
          "model"
        ],
        "title": "ChatResponse"
      },
      "CreateUserRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "full_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "CreateUserRequest"
      },
      "CurrentWeather": {
        "properties": {
          "temperature": {
            "type": "number",
            "title": "Temperature",
            "description": "Air temperature at 2m in Celsius"
          },
          "windspeed": {
            "type": "number",
            "title": "Windspeed",
            "description": "Wind speed at 10m in km/h"
          },
          "winddirection": {
            "type": "integer",
            "title": "Winddirection",
            "description": "Wind direction in degrees"
          },
          "weathercode": {
            "type": "integer",
            "title": "Weathercode",
            "description": "WMO weather condition code"
          },
          "time": {
            "type": "string",
            "title": "Time",
            "description": "Observation time in ISO 8601 format"
          }
        },
        "type": "object",
        "required": [
          "temperature",
          "windspeed",
          "winddirection",
          "weathercode",
          "time"
        ],
        "title": "CurrentWeather"
      },
      "DailyForecast": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date",
            "description": "Date in YYYY-MM-DD format"
          },
          "temperature_2m_max": {
            "type": "number",
            "title": "Temperature 2M Max",
            "description": "Maximum temperature in Celsius"
          },
          "temperature_2m_min": {
            "type": "number",
            "title": "Temperature 2M Min",
            "description": "Minimum temperature in Celsius"
          },
          "precipitation_sum": {
            "type": "number",
            "title": "Precipitation Sum",
            "description": "Total precipitation in mm"
          },
          "precipitation_probability_max": {
            "type": "integer",
            "title": "Precipitation Probability Max",
            "description": "Maximum precipitation probability in %"
          },
          "weathercode": {
            "type": "integer",
            "title": "Weathercode",
            "description": "WMO weather condition code"
          }
        },
        "type": "object",
        "required": [
          "date",
          "temperature_2m_max",
          "temperature_2m_min",
          "precipitation_sum",
          "precipitation_probability_max",
          "weathercode"
        ],
        "title": "DailyForecast"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Error description"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code",
            "description": "Machine-readable error code"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "android": {
            "type": "boolean",
            "title": "Android",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "LoginResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SessionUserResponse"
          },
          "access_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Access Token"
          },
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "user"
        ],
        "title": "LoginResponse"
      },
      "RefreshRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 32,
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest"
      },
      "ResourcesResponse": {
        "properties": {
          "resources": {
            "items": {
              "$ref": "#/components/schemas/AgriculturalResource"
            },
            "type": "array",
            "title": "Resources"
          },
          "total": {
